rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function roomMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/privateRooms/$(roomId)/members/$(request.auth.uid));
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.handle is string
        && request.resource.data.handle.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160;
      allow delete: if isSelf(uid);
    }

    match /privateProfiles/{uid} {
      allow read, create, update, delete: if isSelf(uid)
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120));
    }

    match /loungeMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32
        && request.resource.data.handle is string
        && request.resource.data.handle.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(uid);
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() <= 128
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 160;
      allow update, delete: if false;
    }

    match /privateRooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.version == 1;
      allow read: if roomMember(roomId);
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if roomMember(roomId);
        allow create, update, delete: if isSelf(uid);
      }

      match /messages/{messageId} {
        allow read: if roomMember(roomId);
        allow create: if roomMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.v == 1
          && request.resource.data.iv is string
          && request.resource.data.iv.size() <= 64
          && request.resource.data.cipher is string
          && request.resource.data.cipher.size() > 0
          && request.resource.data.cipher.size() <= 8192;
        allow update: if false;
        allow delete: if roomMember(roomId) && resource.data.uid == request.auth.uid;
      }
    }
  }
}
